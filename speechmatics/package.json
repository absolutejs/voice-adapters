{
  "name": "@absolutejs/voice-speechmatics",
  "version": "0.0.1-beta.5",
  "description": "Speechmatics real-time speech-to-text adapter for @absolutejs/voice",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/absolutejs/voice-adapters.git",
    "directory": "speechmatics"
  },
  "homepage": "https://github.com/absolutejs/voice-adapters/tree/main/speechmatics",
  "bugs": {
    "url": "https://github.com/absolutejs/voice-adapters/issues"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./manifest": {
      "import": "./dist/manifest.js",
      "types": "./dist/manifest.d.ts"
    },
    "./manifest.json": "./dist/manifest.json"
  },
  "license": "CC BY-NC 4.0",
  "author": "Alex Kahn",
  "scripts": {
    "build": "rm -rf dist && bun build ./src/index.ts ./src/manifest.ts --outdir dist --target bun --external @absolutejs/manifest --external '@absolutejs/manifest/*' --external @absolutejs/voice --external '@absolutejs/voice/*' --external @sinclair/typebox --external '@sinclair/typebox/*' && tsc --emitDeclarationOnly --project tsconfig.json && absolute-manifest emit",
    "format": "prettier --write \"./**/*.{js,ts,json,md}\"",
    "release": "bun run check:package && npm publish --access public --tag beta",
    "test": "bun test",
    "typecheck": "bun run tsc --noEmit",
    "verify-package": "absolute-manifest verify-package",
    "check:package": "bun run format && bun run typecheck && bun run test && bun run verify-package && bun run build && bun run verify-package --artifacts"
  },
  "dependencies": {
    "@absolutejs/manifest": "0.7.2",
    "@sinclair/typebox": "0.34.52"
  },
  "devDependencies": {
    "@absolutejs/voice": "0.0.22-beta.647",
    "@types/bun": "1.3.14",
    "elysia": "1.4.29",
    "prettier": "3.9.6",
    "typescript": "^5.9.3"
  },
  "absolutejs": {
    "manifestContract": 2,
    "runtimePeers": {
      "@absolutejs/voice": {
        "artifactImports": [],
        "buildExternals": [
          "@absolutejs/voice",
          "@absolutejs/voice/*"
        ],
        "optional": false,
        "range": ">=0.0.22-beta.647 <0.1",
        "tested": "0.0.22-beta.647"
      }
    }
  },
  "peerDependencies": {
    "@absolutejs/voice": ">=0.0.22-beta.647 <0.1"
  }
}
