{
	"name": "@absolutejs/voice-lmnt",
	"version": "0.0.1-beta.1",
	"description": "LMNT text-to-speech adapter for @absolutejs/voice",
	"repository": {
		"type": "git",
		"url": "https://github.com/absolutejs/voice-adapters.git",
		"directory": "lmnt"
	},
	"files": [
		"dist",
		"README.md"
	],
	"main": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"exports": {
		".": {
			"import": "./dist/index.js",
			"types": "./dist/index.d.ts"
		}
	},
	"license": "CC BY-NC 4.0",
	"author": "Alex Kahn",
	"scripts": {
		"build": "rm -rf dist && bun build ./src/index.ts --outdir dist --target bun --external @absolutejs/voice && tsc --emitDeclarationOnly --project tsconfig.json",
		"format": "prettier --write \"./**/*.{js,ts,json,md}\"",
		"release": "bun run format && bun run build && bun publish --access public",
		"test": "bun test",
		"typecheck": "bun run tsc --noEmit"
	},
	"dependencies": {
		"@absolutejs/voice": "0.0.22-beta.474"
	},
	"devDependencies": {
		"@types/bun": "1.3.9",
		"typescript": "^5.9.3"
	}
}
